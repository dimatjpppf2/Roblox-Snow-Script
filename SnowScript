--========================================================
-- ❄️ СНЕГ ТОЛЬКО НА СТАТИЧНЫХ ПОВЕРХНОСТЯХ
--========================================================

task.spawn(function()
    task.wait(2)

    while true do
        local character = player.Character
        local currentCamera = workspace.CurrentCamera

        if character and currentCamera then
            local randomX = math.random(-SNOW_RADIUS, SNOW_RADIUS)
            local randomZ = math.random(-SNOW_RADIUS, SNOW_RADIUS)

            if randomX * randomX + randomZ * randomZ
                <= SNOW_RADIUS * SNOW_RADIUS then

                local origin =
                    currentCamera.CFrame.Position
                    + Vector3.new(randomX, SNOW_HEIGHT, randomZ)

                local direction = Vector3.new(
                    0,
                    -SNOW_HEIGHT * 2,
                    0
                )

                local excluded = {
                    character,
                    snowFolder
                }

                local result = nil

                -- Пропускаем движущиеся объекты и стены
                for attempt = 1, 12 do
                    rayParams.FilterType =
                        Enum.RaycastFilterType.Exclude

                    rayParams.FilterDescendantsInstances =
                        excluded

                    result = workspace:Raycast(
                        origin,
                        direction,
                        rayParams
                    )

                    if not result then
                        break
                    end

                    local hit = result.Instance

                    local isStatic =
                        hit == workspace.Terrain
                        or (
                            hit:IsA("BasePart")
                            and hit.Anchored
                        )

                    local isFloor =
                        result.Normal.Y >= 0.85

                    if isStatic and isFloor then
                        break
                    end

                    table.insert(excluded, hit)
                    result = nil
                end

                if result then
                    createSnowPart(
                        result.Position,
                        result.Normal
                    )
                end
            end
        end

        task.wait(getGroundDelay())
    end
end)
