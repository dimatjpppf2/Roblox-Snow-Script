--========================================================

local BASE_MIN_RADIUS = 12
local BASE_MAX_RADIUS = 150

local MAX_FLAKES = 400
local flakes = {}

local function getRandomOffset()
    local scale = getSnowRadiusScale()
    local minRadius = BASE_MIN_RADIUS * scale
    local maxRadius = BASE_MAX_RADIUS * scale

    local direction = Vector3.new(
        math.random() * 2 - 1,
        math.random() * 2 - 1,
        math.random() * 2 - 1
    )

    if direction.Magnitude < 0.001 then
        direction = Vector3.new(0, 1, 0)
    end

    direction = direction.Unit

    -- Равномерное распределение по объёму сферы
    local radius = (
        minRadius ^ 3
        + math.random() * (maxRadius ^ 3 - minRadius ^ 3)
    ) ^ (1 / 3)

    return direction * radius
end

local function createFlake()
    local flake = Instance.new("Part")
    flake.Name = "Snowflake"
    flake.Anchored = true
    flake.CanCollide = false
    flake.CanTouch = false
    flake.CanQuery = false
    flake.CastShadow = false
    flake.Material = Enum.Material.SmoothPlastic
    flake.Color = Color3.new(1, 1, 1)
    flake.Transparency = math.random(0, 30) / 100

    local size = math.random(10, 35) / 100
    flake.Size = Vector3.new(size, 0.035, size)
    flake.Parent = emitterFolder

    return {
        part = flake,
        offset = getRandomOffset(),
        speed = math.random(40, 90) / 10,
        drift = Vector3.new(
            math.random(-15, 15) / 10,
            0,
            math.random(-15, 15) / 10
        )
    }
end

-- Создаём снежинки по одной
for i = 1, MAX_FLAKES do
    flakes[i] = createFlake()
end

RunService.RenderStepped:Connect(function(dt)
    local currentCamera = workspace.CurrentCamera
    if not currentCamera then return end

    local scale = getSnowRadiusScale()
    local minRadius = BASE_MIN_RADIUS * scale
    local maxRadius = BASE_MAX_RADIUS * scale

    -- Ползунок количества управляет числом видимых снежинок
    local activeCount = math.clamp(
        math.floor(getParticleRate()),
        1,
        MAX_FLAKES
    )

    local cameraPosition = currentCamera.CFrame.Position

    for i, data in ipairs(flakes) do
        local flake = data.part

        if i <= activeCount then
            flake.Transparency = 0.1

            data.offset += (
                Vector3.new(0, -data.speed, 0)
                + data.drift
            ) * dt

            local distance = data.offset.Magnitude

            -- Не допускаем появления снежинок возле камеры
            if distance <= minRadius or distance >= maxRadius then
                data.offset = getRandomOffset()
            end

            flake.Position = cameraPosition + data.offset
        else
            flake.Transparency = 1
        end
    end
end)


--========================================================
-- ❄️ СНЕГ НА ЗЕМЛЕ
--========================================================

local rayParams =
	RaycastParams.new()

local function createSnowPart(
	position,
	normal
)

	local snow =
		Instance.new("Part")

	snow.Name = "Snow"

	snow.Size =
		Vector3.new(
			math.random(
				MIN_SNOW_SIZE,
				MAX_SNOW_SIZE
			),

			0.12,

			math.random(
				MIN_SNOW_SIZE,
				MAX_SNOW_SIZE
			)
		)

	snow.Anchored = true

	snow.CanCollide = false
	snow.CanTouch = false
	snow.CanQuery = false

	snow.Material =
		Enum.Material.Snow

	snow.Color =
		Color3.fromRGB(
			235,
			240,
			245
		)

	snow.Transparency = 0.05

	snow.CFrame =
		CFrame.new(
			position
				+ normal * 0.06
		)

	snow.Parent =
		groundFolder

end

