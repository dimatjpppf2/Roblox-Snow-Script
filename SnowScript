--========================================================
-- ❄️ РАВНОМЕРНЫЙ СПАВН СНЕЖИНОК ВОКРУГ КАМЕРЫ
--========================================================

local BASE_MIN_RADIUS = 9
local BASE_MAX_RADIUS = 37.5

local EMITTER_COUNT = 96
local emitters = {}

local snowEmitterPart = Instance.new("Part")
snowEmitterPart.Name = "SnowSphere"
snowEmitterPart.Size = Vector3.new(1, 1, 1)
snowEmitterPart.Anchored = true
snowEmitterPart.CanCollide = false
snowEmitterPart.CanTouch = false
snowEmitterPart.CanQuery = false
snowEmitterPart.Transparency = 1
snowEmitterPart.Parent = emitterFolder

local goldenAngle = math.pi * (3 - math.sqrt(5))

for i = 0, EMITTER_COUNT - 1 do

    local y = 1 - 2 * (i + 0.5) / EMITTER_COUNT
    local horizontal = math.sqrt(1 - y * y)
    local angle = goldenAngle * i

    local direction = Vector3.new(
        math.cos(angle) * horizontal,
        y,
        math.sin(angle) * horizontal
    )

    local radialSample = (i + math.random()) / EMITTER_COUNT

    local attachment = Instance.new("Attachment")
    attachment.Name = "SnowPoint"
    attachment.Parent = snowEmitterPart

    local emitter = Instance.new("ParticleEmitter")
    emitter.Name = "Snowfall"
    emitter.Parent = attachment

    emitter.Rate = 0
    emitter.Lifetime = NumberRange.new(4, 7)
    emitter.Speed = NumberRange.new(7, 10)
    emitter.Acceleration = Vector3.new(0, -3, 0)
    emitter.Drag = 0

    emitter.EmissionDirection = Enum.NormalId.Bottom
    emitter.SpreadAngle = Vector2.new(8, 8)

    emitter.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.18, 0.08),
        NumberSequenceKeypoint.new(1, 0.12, 0.05)
    })

    emitter.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.1),
        NumberSequenceKeypoint.new(1, 0.5)
    })

    emitter.Color = ColorSequence.new(
        Color3.fromRGB(255, 255, 255)
    )

    emitter.LightEmission = 0.1
    emitter.RotSpeed = NumberRange.new(-40, 40)

    table.insert(emitters, {
        attachment = attachment,
        emitter = emitter,
        direction = direction,
        radialSample = radialSample
    })
end

--========================================================
-- ОБНОВЛЕНИЕ СФЕРЫ И СНЕЖИНОК
--========================================================

local lastRate = -1

RunService.RenderStepped:Connect(function()

    camera = workspace.CurrentCamera
    if not camera then return end

    local minRadius = BASE_MIN_RADIUS
    local maxRadius = BASE_MAX_RADIUS

    snowEmitterPart.Position = camera.CFrame.Position

    local currentRate = getParticleRate()

    if currentRate ~= lastRate then

        lastRate = currentRate

        for _, data in ipairs(emitters) do
            data.emitter.Rate = currentRate / EMITTER_COUNT
        end
    end

    for _, data in ipairs(emitters) do

        local radius = (
            minRadius ^ 3
            + data.radialSample * (
                maxRadius ^ 3 - minRadius ^ 3
            )
        ) ^ (1 / 3)

        data.attachment.Position =
            data.direction * radius
    end
end)


--========================================================
-- ❄️ СНЕГ НА ЗЕМЛЕ
--========================================================
local rayParams =
	RaycastParams.new()

local function createSnowPart(
	position,
	normal
)

	local snow =
		Instance.new("Part")

	snow.Name = "Snow"

	snow.Size =
		Vector3.new(
			math.random(
				MIN_SNOW_SIZE,
				MAX_SNOW_SIZE
			),

			0.12,

			math.random(
				MIN_SNOW_SIZE,
				MAX_SNOW_SIZE
			)
		)

	snow.Anchored = true

	snow.CanCollide = false
	snow.CanTouch = false
	snow.CanQuery = false

	snow.Material =
		Enum.Material.Snow

	snow.Color =
		Color3.fromRGB(
			235,
			240,
			245
		)

	snow.Transparency = 0.05

	snow.CFrame =
		CFrame.new(
			position
				+ normal * 0.06
		)

	snow.Parent =
		groundFolder

end

--========================================================
-- ❄️ СНЕГ ТОЛЬКО НА СТАТИЧНЫХ ПОВЕРХНОСТЯХ
--========================================================

task.spawn(function()
    task.wait(2)

    while true do
        local character = player.Character
        local currentCamera = workspace.CurrentCamera

        if groundSnowEnabled and character and currentCamera then
            local randomX = math.random(-SNOW_RADIUS, SNOW_RADIUS)
            local randomZ = math.random(-SNOW_RADIUS, SNOW_RADIUS)

            if randomX * randomX + randomZ * randomZ
                <= SNOW_RADIUS * SNOW_RADIUS then

                local origin =
                    currentCamera.CFrame.Position
                    + Vector3.new(randomX, SNOW_HEIGHT, randomZ)

                local direction = Vector3.new(
                    0,
                    -SNOW_HEIGHT * 2,
                    0
                )

                local excluded = {
                    character,
                    snowFolder
                }

                local result = nil

                for attempt = 1, 12 do
                    rayParams.FilterType =
                        Enum.RaycastFilterType.Exclude

                    rayParams.FilterDescendantsInstances =
                        excluded

                    result = workspace:Raycast(
                        origin,
                        direction,
                        rayParams
                    )

                    if not result then
                        break
                    end

                    local hit = result.Instance

                    local isStatic =
                        hit == workspace.Terrain
                        or (
                            hit:IsA("BasePart")
                            and hit.Anchored
                        )
					local isFloor =
    					result.Normal.Y >= 0.85

					local isLargeEnough = true

					if hit:IsA("BasePart") then
    					local localNormal =
        					hit.CFrame:VectorToObjectSpace(result.Normal)

    					local absNormal = Vector3.new(
        					math.abs(localNormal.X),
        					math.abs(localNormal.Y),
        					math.abs(localNormal.Z)
    					)

    					local sizeA, sizeB

    					if absNormal.X >= absNormal.Y and absNormal.X >= absNormal.Z then
        					sizeA, sizeB = hit.Size.Y, hit.Size.Z
    					elseif absNormal.Y >= absNormal.X and absNormal.Y >= absNormal.Z then
        					sizeA, sizeB = hit.Size.X, hit.Size.Z
    					else
        					sizeA, sizeB = hit.Size.X, hit.Size.Y
    					end

    					isLargeEnough = sizeA >= 5 and sizeB >= 5
					end

					if isStatic and isFloor and isLargeEnough then
    					break
					end

                    table.insert(excluded, hit)
                    result = nil
                end

                if result then
                    createSnowPart(
                        result.Position,
                        result.Normal
                    )
                end
            end
        end

        task.wait(getGroundDelay())
    end
end)
