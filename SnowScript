print("SNOW GROUND SYSTEM STARTED")
print("Texture ID:", "rbxassetid://2861800")

local SNOW_TEXTURE_ID = "http://www.roblox.com/asset/?id=2861800"

-- Размер повторения текстуры в студиях.
-- Чем больше число, тем крупнее рисунок.
local SNOW_TILE_SIZE = 8

-- Прозрачность текстуры
local SNOW_TRANSPARENCY = 0.12

-- Радиус обработки вокруг камеры
local GROUND_COVERAGE_RADIUS = 150

-- Как часто проверять новые поверхности
local SCAN_INTERVAL = 0.75

-- Удаляем старые снежные Parts от прежней системы
groundFolder:ClearAllChildren()

-- Запоминаем текстуры, которые уже созданы
local coveredParts = {}

local overlapParams = OverlapParams.new()
overlapParams.FilterType = Enum.RaycastFilterType.Exclude
overlapParams.FilterDescendantsInstances = {
    snowFolder
}

--========================================================
-- ПРОВЕРКА ПОДХОДЯЩЕЙ ДЕТАЛИ
--========================================================

local function isSnowSurface(part)

    if not part:IsA("BasePart") then
        return false
    end

    -- Не покрываем импортированную геометрию
    if part:IsA("MeshPart") then
        return false
    end

    if part:IsA("UnionOperation") then
        return false
    end

    -- Только закреплённые детали
    if not part.Anchored then
        return false
    end

    -- Пропускаем Parts с импортированной геометрией
    if part:FindFirstChildWhichIsA("SpecialMesh") then
        return false
    end

    -- Не покрываем персонажей и NPC
    local model = part:FindFirstAncestorOfClass("Model")

    if model and model:FindFirstChildOfClass("Humanoid") then
        return false
    end

    return true
end

--========================================================
-- ВЫБОР ВЕРХНЕЙ ГРАНИ
--========================================================

local function getTopFace(part)

    local up = part.CFrame.UpVector
    local right = part.CFrame.RightVector
    local look = part.CFrame.LookVector

    local faces = {
        {Enum.NormalId.Top, up},
        {Enum.NormalId.Bottom, -up},
        {Enum.NormalId.Right, right},
        {Enum.NormalId.Left, -right},
        {Enum.NormalId.Front, look},
        {Enum.NormalId.Back, -look}
    }

    local bestFace = nil
    local bestDot = -1

    for _, data in ipairs(faces) do

        local dot = data[2]:Dot(Vector3.yAxis)

        if dot > bestDot then
            bestDot = dot
            bestFace = data[1]
        end
    end

    -- Не покрываем практически вертикальные грани
    if bestDot < 0.45 then
        return nil
    end

    return bestFace
end

--========================================================
-- НАЛОЖЕНИЕ ТЕКСТУРЫ
--========================================================

local function applySnowTexture(part)
    if not isSnowSurface(part) then
        return
    end

    local face = getTopFace(part)
    if not face then
        print("NO TOP FACE:", part:GetFullName())
        return
    end

    print("APPLYING SNOW:", part:GetFullName(), face)

    local texture = Instance.new("Texture")

    texture.Name = "LocalSnowTexture"
    texture.Texture = SNOW_TEXTURE_ID
    texture.Face = face

    texture.StudsPerTileU = SNOW_TILE_SIZE
    texture.StudsPerTileV = SNOW_TILE_SIZE

    texture.Transparency = SNOW_TRANSPARENCY
    texture.Color3 = Color3.fromRGB(245, 250, 255)

    texture.Parent = part
	task.delay(2, function()
    	print(
        "TEXTURE CHECK:",
        texture.Parent,
        texture.Texture,
        texture.IsLoaded
    	)
	end)

    coveredParts[part] = texture
end

--========================================================
-- УДАЛЕНИЕ ПОКРЫТИЯ ВДАЛИ ОТ КАМЕРЫ
--========================================================

local function updateSnowCoverage()

    local currentCamera = workspace.CurrentCamera

    if not currentCamera then
        return
    end

    local cameraPosition = currentCamera.CFrame.Position

    -- Находим детали вокруг камеры
    local nearbyParts = workspace:GetPartBoundsInRadius(
        cameraPosition,
        GROUND_COVERAGE_RADIUS,
        overlapParams
    )

	print("Found parts:", #nearbyParts)

    -- Добавляем снег новым деталям
    for _, part in ipairs(nearbyParts) do
        applySnowTexture(part)
    end

    -- Удаляем покрытие далеко от камеры
    for part, texture in pairs(coveredParts) do

        if not part.Parent then

            coveredParts[part] = nil

        else

            local distance = (
                part.Position - cameraPosition
            ).Magnitude

            local partRadius = part.Size.Magnitude / 2

            if distance > GROUND_COVERAGE_RADIUS + partRadius then

                texture:Destroy()
                coveredParts[part] = nil

            end
        end
    end
end

--========================================================
-- ЦИКЛ ОБНОВЛЕНИЯ
--========================================================

task.spawn(function()

    task.wait(1)

    while true do

        updateSnowCoverage()

        task.wait(SCAN_INTERVAL)

    end

end)
