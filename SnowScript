--==================================================
-- ПЛАВНЫЙ ЗАПУСК СНЕГОПАДА
--==================================================

task.spawn(function()

	local currentRate = 20

	while currentRate <
		PARTICLE_RATE do

		-- Увеличиваем постепенно
		currentRate += 20

		if currentRate >
			PARTICLE_RATE then

			currentRate =
				PARTICLE_RATE
		end

		emitter.Rate =
			currentRate

		task.wait(0.15)
	end
end)

--==================================================
-- СОЗДАНИЕ СНЕЖНОГО PART
--==================================================

local function createSnowPart(
	position,
	normal
)

	local snow =
		Instance.new("Part")

	snow.Name =
		"Snow"

	snow.Anchored = true

	snow.CanCollide =
		false

	snow.CanTouch =
		false

	snow.CanQuery =
		false

	snow.Material =
		Enum.Material.Snow

	snow.Color =
		SNOW_COLOR

	snow.Transparency =
		0.05

	snow.Size =
		Vector3.new(
			GROUND_SIZE,
			GROUND_THICKNESS,
			GROUND_SIZE
		)

	snow.Position =
		position +
		normal *
		(GROUND_THICKNESS / 2)

	snow.Parent =
		groundFolder
end

--==================================================
-- СЛЕДИМ ЗА КАМЕРОЙ
--==================================================

RunService.RenderStepped:Connect(function()

	camera =
		Workspace.CurrentCamera

	if camera then

		snowEmitterPart.Position =
			camera.CFrame.Position +
			Vector3.new(
				0,
				SNOW_HEIGHT,
				0
			)

	end
end)

--==================================================
-- ГЕНЕРАЦИЯ СНЕГА НА ЗЕМЛЕ
--==================================================

task.spawn(function()

	while true do

		camera =
			Workspace.CurrentCamera

		if camera then

			for i = 1,
				PARTS_PER_BATCH do

				-- Проверяем лимит
				if #groundFolder:GetChildren()
					>= MAX_SNOW_PARTS then

					break
				end

				local cameraPos =
					camera.CFrame.Position

				local randomOffset =
					Vector3.new(
						math.random(
							-SNOW_RADIUS,
							SNOW_RADIUS
						),

						60,

						math.random(
							-SNOW_RADIUS,
							SNOW_RADIUS
						)
					)

				local rayOrigin =
					cameraPos +
					randomOffset

				local params =
					RaycastParams.new()

				params.FilterType =
					Enum.RaycastFilterType.Exclude

				params.FilterDescendantsInstances = {
					player.Character,
					snowFolder
				}

				local result =
					Workspace:Raycast(
						rayOrigin,
						Vector3.new(
							0,
							-150,
							0
						),
						params
					)

				if result and
					result.Normal.Y > 0.7 then

					createSnowPart(
						result.Position,
						result.Normal
					)

				end

			end
		end

		task.wait(
			GROUND_SPAWN_DELAY
		)

		task.wait(
			BATCH_DELAY
		)
	end
end)

