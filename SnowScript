--========================================================
-- ❄️ СНЕГ НА ЗЕМЛЕ
--========================================================

local rayParams =
	RaycastParams.new()

local function createSnowPart(
	position,
	normal
)

	local snow =
		Instance.new("Part")

	snow.Name = "Snow"

	snow.Size =
		Vector3.new(
			math.random(
				MIN_SNOW_SIZE,
				MAX_SNOW_SIZE
			),

			0.12,

			math.random(
				MIN_SNOW_SIZE,
				MAX_SNOW_SIZE
			)
		)

	snow.Anchored = true

	snow.CanCollide = false
	snow.CanTouch = false
	snow.CanQuery = false

	snow.Material =
		Enum.Material.Snow

	snow.Color =
		Color3.fromRGB(
			235,
			240,
			245
		)

	snow.Transparency = 0.05

	snow.CFrame =
		CFrame.new(
			position
				+ normal * 0.06
		)

	snow.Parent =
		groundFolder

end

--========================================================
-- ПОСТЕПЕННОЕ ПОЯВЛЕНИЕ СНЕГА НА ЗЕМЛЕ
--========================================================

task.spawn(function()

	task.wait(2)

	while true do

		local character =
			player.Character

		if character then

			rayParams.FilterType =
				Enum.RaycastFilterType.Exclude

			rayParams.FilterDescendantsInstances =
				{
					character,
					snowFolder
				}

			-- Ищем случайную точку
			-- в большом радиусе вокруг камеры

			local randomX =
				math.random(
					-SNOW_RADIUS,
					SNOW_RADIUS
				)

			local randomZ =
				math.random(
					-SNOW_RADIUS,
					SNOW_RADIUS
				)

			-- Проверяем, что точка находится
			-- внутри круга по X/Z

			if
				randomX * randomX
				+
				randomZ * randomZ
				<=
				SNOW_RADIUS * SNOW_RADIUS
			then

				local origin =
					camera.CFrame.Position
					+
					Vector3.new(
						randomX,
						SNOW_HEIGHT,
						randomZ
					)

				local result =
					workspace:Raycast(
						origin,
						Vector3.new(
							0,
							-SNOW_HEIGHT * 2,
							0
						),
						rayParams
					)

				if result then

					createSnowPart(
						result.Position,
						result.Normal
					)

				end

			end

		end

		task.wait(
			getGroundDelay()
		)

	end

end)
