--========================================================
-- ❄️ РАВНОМЕРНЫЙ СПАВН СНЕЖИНОК ВОКРУГ КАМЕРЫ
--========================================================

local BASE_MIN_RADIUS = 36
local BASE_MAX_RADIUS = 150

local EMITTER_COUNT = 96
local emitters = {}

local snowEmitterPart = Instance.new("Part")
snowEmitterPart.Name = "SnowSphere"
snowEmitterPart.Size = Vector3.new(1, 1, 1)
snowEmitterPart.Anchored = true
snowEmitterPart.CanCollide = false
snowEmitterPart.CanTouch = false
snowEmitterPart.CanQuery = false
snowEmitterPart.Transparency = 1
snowEmitterPart.Parent = emitterFolder

local goldenAngle = math.pi * (3 - math.sqrt(5))

for i = 0, EMITTER_COUNT - 1 do

    -- Равномерное распределение направлений по сфере
    local y = 1 - 2 * (i + 0.5) / EMITTER_COUNT
    local horizontal = math.sqrt(1 - y * y)
    local angle = goldenAngle * i

    local direction = Vector3.new(
        math.cos(angle) * horizontal,
        y,
        math.sin(angle) * horizontal
    )

    -- Разносим эмиттеры и по внутреннему объёму сферы
    local radialSample = (i + math.random()) / EMITTER_COUNT

    local attachment = Instance.new("Attachment")
    attachment.Name = "SnowPoint"
    attachment.Parent = snowEmitterPart

    local emitter = Instance.new("ParticleEmitter")
    emitter.Name = "Snowfall"
    emitter.Parent = attachment

    emitter.Rate = 0
    emitter.Lifetime = NumberRange.new(4, 7)
    emitter.Speed = NumberRange.new(7, 10)
    emitter.Acceleration = Vector3.new(0, -3, 0)
    emitter.Drag = 0

    emitter.EmissionDirection = Enum.NormalId.Bottom
    emitter.SpreadAngle = Vector2.new(8, 8)

    -- Случайный размер каждой частицы
    emitter.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.18, 0.08),
        NumberSequenceKeypoint.new(1, 0.12, 0.05)
    })

    emitter.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.1),
        NumberSequenceKeypoint.new(1, 0.5)
    })

    emitter.Color = ColorSequence.new(
        Color3.fromRGB(255, 255, 255)
    )

    emitter.LightEmission = 0.1
    emitter.RotSpeed = NumberRange.new(-40, 40)

    table.insert(emitters, {
        attachment = attachment,
        emitter = emitter,
        direction = direction,
        radialSample = radialSample
    })
end

--========================================================
-- ОБНОВЛЕНИЕ СФЕРЫ И СНЕЖИНОК
--========================================================

local lastRate = -1

RunService.RenderStepped:Connect(function()

    camera = workspace.CurrentCamera
    if not camera then return end

    local scale = getSnowRadiusScale()

    local minRadius = BASE_MIN_RADIUS * scale
    local maxRadius = BASE_MAX_RADIUS * scale

    -- Перемещаем невидимую основу к камере
    snowEmitterPart.Position = camera.CFrame.Position

    -- Обновляем количество частиц
    local currentRate = getParticleRate()

    if currentRate ~= lastRate then

        lastRate = currentRate

        for _, data in ipairs(emitters) do
            data.emitter.Rate = currentRate / EMITTER_COUNT
        end
    end

    -- Обновляем позиции точек появления
    for _, data in ipairs(emitters) do

        local radius = (
            minRadius ^ 3
            + data.radialSample * (
                maxRadius ^ 3 - minRadius ^ 3
            )
        ) ^ (1 / 3)

        data.attachment.Position =
            data.direction * radius
    end
end)



